# Maintainer: Tu Nombre <tu@correo.com>
#
# Paquete de CalcTUI para Arch / AUR.
# Proceso para generarlo y subirlo: ver packaging/README.md

pkgname=calctui
pkgver=0.1.0
pkgrel=1
pkgdesc='Calculadora de terminal con porcentaje, exponentes, raices y parentesis'
arch=('x86_64')
url='https://github.com/TU_USUARIO/CalcTUI'
license=('GPL-3.0-only')
depends=()
makedepends=('rust')
provides=('calctui')
conflicts=()
replaces=()

# sin sufijo para que makeppeg el codigo en src/calctui-0.1.0
source=("$pkgname-$pkgver::git+https://github.com/TU_USUARIO/CalcTUI.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    # --locked respeta el Cargo.lock: el paquete siempre compila la misma version
    cargo build --release --locked
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --locked
}

package() {
    install -Dm755 "$pkgname-$pkgver/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
